# Claude per-checkout local state (never committed)
.claude/settings.local.json
.claude/projects/

# Nix
result
result-*

# Go
*.test
*.out

# sops filter is wired globally (core.attributesFile); keep a local .sops.yaml
# to satisfy the smudge/clean filter, but this repo has no sops content to commit.
.sops.yaml

# Claude per-checkout tooling state (memory, sessions) — local only
.claude/

# Operator's local re-aim of the flake-input registry. REPLACES the committed
# flake-registry.json when present (see the [include] in .flox/env/manifest.toml).
# Ignored rather than tracked so a local re-aim never reads as a dirty tree to
# relock's guard rail — which is also why it cannot simply be `git add -f`'ed:
# .gitignore stops protecting a file the moment it is tracked.
flake-registry.local.json
